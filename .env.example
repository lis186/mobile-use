# Copy this file to `.env` (which is gitignored) and fill in real keys.
# Only the provider you plan to use needs a value.

# Google Generative AI (Gemini) — default provider for `phone-use audit`
# and for any model name starting with `gemini-`.
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key_here

# OpenAI — used when you pass a model name starting with `gpt-` or `o`.
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
